---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Tagline from "../components/Tagline.astro";
import Events from "../components/Events.astro";
import Floaters from "../components/Floaters.astro";
import GamesTape from "../components/GamesTape.astro";
import irisMiku from "../assets/iris-miku.png";
---

<Layout>
  <div class="relative isolate flex w-full items-center justify-between py-24">
    <Floaters />
    <div class="flex flex-col items-start gap-6">
      <Tagline text="ILLINI RHYTHM SYNDICATE" />
      <h1 class="font-display text-6xl font-bold">
        We <span class="text-irs-pink-deep">build</span> and <span
          class="text-irs-cyan-deep">play</span
        >
        <br />rhythm games.
      </h1>
      <p class="font-body text-xl max-w-md">
        Illini Rhythm Syndicate is UIUC's club for rhythm game enthusiasts.
      </p>
      <a
        href="https://discord.gg/q9yuXE2PMu"
        target="_blank"
        class="font-display text-xl font-bold px-6 py-3 border-3 border-irs-ink rounded-full bg-irs-pink text-irs-ink transition shadow-[4px_4px_0_0_var(--color-irs-ink)] hover:bg-irs-pink-deep hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--color-irs-ink)]"
      >
        Join the Discord
      </a>
    </div>

    <Image
      src={irisMiku}
      alt="Iris-chan"
      class="aspect-3/4 w-full max-w-sm shrink-0 rounded-3xl border-3 border-irs-ink bg-white object-cover shadow-[6px_6px_0_0_var(--color-irs-ink)] transition duration-300 rotate-2 hover:rotate-0 hover:scale-105"
      priority
    />
  </div>

  <GamesTape />

  <Events />
</Layout>
