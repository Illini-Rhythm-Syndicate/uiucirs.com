---
import Layout from "../layouts/Layout.astro";
import Tagline from "../components/Tagline.astro";
---

<Layout>
  <div
    class="flex flex-col items-start gap-5 py-14 sm:gap-6 sm:py-20 lg:py-24 max-w-4xl"
  >
    <Tagline text="PROJECT TEAMS" />
    <h1
      class="font-display text-3xl font-bold sm:text-4xl lg:text-6xl 2xl:text-7xl"
    >
      Come build with us!
    </h1>
    <p class="font-body text-base sm:text-lg lg:text-xl">
      More information will be added to this page at a later date.
    </p>
    <p class="font-body text-base sm:text-lg lg:text-xl">
      In the meantime, come check out our General Meeting on August 31st at 5PM,
      Everitt Lab 2310!
    </p>
  </div>
</Layout>
