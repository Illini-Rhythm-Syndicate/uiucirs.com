---
import logo from "../assets/logo.png";
import { Image } from "astro:assets";
import HeaderNavButton from "./HeaderNavButton.astro";

const navLinks = [
  { title: "Home", href: "/" },
  { title: "About", href: "/about" },
  { title: "Freeplays", href: "/freeplays" },
  { title: "Project Teams", href: "/teams" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="flex items-center justify-between px-6 py-4 border-b-3">
  <a href="/" class="flex items-center gap-2 group">
    <Image
      src={logo}
      alt="Illini Rhythm Syndicate"
      class="w-16 h-16"
      priority
    />
    <div class="flex flex-col">
      <span
        class="font-bold font-display text-xl group-hover:text-irs-teal transition"
      >
        Illini Rhythm Syndicate
      </span>
      <span
        class="font-display text-lg leading-tight group-hover:text-irs-teal transition"
        >UIUC's rhythm game club</span
      >
    </div>
  </a>

  <nav class="flex items-center justify-between gap-4 ml-auto">
    {
      navLinks.map((link) => (
        <HeaderNavButton
          title={link.title}
          href={link.href}
          active={(link.href.replace(/\/$/, "") || "/") === currentPath}
        />
      ))
    }
    <a
      href="https://discord.gg/q9yuXE2PMu"
      target="_blank"
      class="font-display text-xl font-bold px-6 py-3 border-3 border-black rounded-full transition shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_rgba(0,0,0,1)]"
    >
      Join the Discord
    </a>
  </nav>
</header>
