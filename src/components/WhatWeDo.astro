---
import {
  FaGamepad,
  FaScrewdriverWrench,
  FaSchool,
  FaTrophy,
  FaUsers,
  FaVanShuttle,
} from "react-icons/fa6";
const activities = [
  {
    Icon: FaGamepad,
    color: "text-irs-pink-deep",
    title: "Freeplay",
    description:
      "Come unwind after class and explore new rhythm games with our weekly freeplays. All skill levels welcome!",
  },
  {
    Icon: FaTrophy,
    color: "text-irs-coral",
    title: "Tournaments",
    description:
      "Test your skills and forge new rivalries in our regularly-organized tournaments and competitions.",
  },
  {
    Icon: FaScrewdriverWrench,
    color: "text-irs-cyan-deep",
    title: "Engineering & maintenance",
    description:
      "Join us as we design, build, and repair our own controllers and cabs.",
  },
  {
    Icon: FaSchool,
    color: "text-irs-green",
    title: "Conventions & events",
    description:
      "We haul our setups to campus events like UI-CON and Quad Day for anyone to try.",
  },
  {
    Icon: FaVanShuttle,
    color: "text-irs-navy",
    title: "Arcade trips",
    description:
      "Group trips to arcades in Chicago. Schedules and carpools are announced in the Discord.",
  },
  {
    Icon: FaUsers,
    color: "text-irs-gold",
    title: "Social gatherings",
    description:
      "Come hang out outside of rhythm games with watch parties, food runs, and party games.",
  },
];
---

<div class="flex w-full flex-col gap-5 py-10 sm:gap-6 sm:py-12">
  <div class="flex flex-col gap-1.5">
    <h2 class="font-display text-3xl font-bold sm:text-4xl 2xl:text-5xl">
      What We Do
    </h2>
  </div>

  <ul class="grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {
      activities.map(({ Icon, color, title, description }) => (
        <li class="flex flex-col gap-2 rounded-3xl border-3 border-irs-ink bg-irs-cream p-5 text-irs-ink shadow-[4px_4px_0_0_var(--color-irs-ink)] transition hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[8px_8px_0_0_var(--color-irs-ink)]">
          <h3 class="flex items-center gap-2.5 font-display text-xl font-bold sm:text-2xl">
            <Icon className={`shrink-0 size-5 sm:size-6 ${color}`} />
            {title}
          </h3>
          <p class="font-body text-sm sm:text-base">{description}</p>
        </li>
      ))
    }
  </ul>
</div>
