---
import {
  FaGamepad,
  FaScrewdriverWrench,
  FaSchool,
  FaTrophy,
  FaUsers,
  FaVanShuttle,
} from "react-icons/fa6";
const activities = [
  {
    Icon: FaGamepad,
    color: "text-irs-pink-deep",
    title: "Freeplay",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
  {
    Icon: FaTrophy,
    color: "text-irs-coral",
    title: "Tournaments",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
  {
    Icon: FaScrewdriverWrench,
    color: "text-irs-cyan-deep",
    title: "Engineering & maintenance",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
  {
    Icon: FaSchool,
    color: "text-irs-green",
    title: "Conventions & campus events",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
  {
    Icon: FaVanShuttle,
    color: "text-irs-navy",
    title: "Arcade trips",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
  {
    Icon: FaUsers,
    color: "text-irs-gold",
    title: "Social gatherings",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
];
---

<div class="flex w-full flex-col gap-5 py-10 sm:gap-6 sm:py-12">
  <div class="flex flex-col gap-1.5">
    <h2 class="font-display text-3xl font-bold sm:text-4xl 2xl:text-5xl">
      What We Do
    </h2>
    <p class="font-body text-base sm:text-lg 2xl:text-xl">
      Free play, tournaments, build nights, and everything in between.
    </p>
  </div>

  <ul class="grid gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {
      activities.map(({ Icon, color, title, description }) => (
        <li class="flex flex-col gap-2 rounded-3xl border-3 border-irs-ink bg-irs-cream p-5 text-irs-ink shadow-[4px_4px_0_0_var(--color-irs-ink)] sm:p-6 sm:shadow-[6px_6px_0_0_var(--color-irs-ink)]">
          <h3 class="flex items-center gap-2.5 font-display text-xl font-bold sm:text-2xl">
            <Icon className={`shrink-0 size-5 sm:size-6 ${color}`} />
            {title}
          </h3>
          <p class="font-body text-sm sm:text-base">{description}</p>
        </li>
      ))
    }
  </ul>
</div>
