---
// Full-bleed lavender band with scalloped top and bottom edges: lavender discs
// on a 26px grid, bulging up from below the strip on top and down from above
// it on the bottom.
const scallopSize = "background-size: 26px 26px;";
const scallopTop = `background-image: radial-gradient(circle at 13px 30px, var(--color-irs-lav) 14px, transparent 15px); ${scallopSize}`;
const scallopBottom = `background-image: radial-gradient(circle at 13px -4px, var(--color-irs-lav) 14px, transparent 15px); ${scallopSize}`;
---

<section class="relative left-1/2 w-screen -translate-x-1/2">
  <div class="h-6.5 w-full" style={scallopTop} aria-hidden="true"></div>

  <div class="w-full bg-irs-lav py-10 sm:py-12">
    <div
      class="mx-auto flex w-full max-w-5xl flex-col gap-5 px-5 sm:gap-6 sm:px-8 xl:max-w-6xl 2xl:max-w-7xl 3xl:max-w-360"
    >
      <slot />
    </div>
  </div>

  <div class="h-6.5 w-full" style={scallopBottom} aria-hidden="true"></div>
</section>
