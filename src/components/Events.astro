---
import { getCollection } from "astro:content";
import EventsCarousel from "./EventsCarousel";
import MascotSticker from "./MascotSticker.astro";
import ScallopBand from "./ScallopBand.astro";
import irisMaimai from "../assets/iris-maimai.png";
import irisOngeki from "../assets/iris-ongeki.png";
import { SITE } from "../data/site";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const today = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Chicago",
}).format(new Date());

const upcoming = (await getCollection("events"))
  .filter((event) => event.data.date.toISOString().slice(0, 10) >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const events = upcoming.map((event) => ({
  title: event.data.title,
  description: event.data.description,
  date: dateFormatter.format(event.data.date),
  time: event.data.time,
  location: event.data.location,
}));

// Event structured data so upcoming events can surface directly in search.
const eventsSchema = upcoming.map((event) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.data.title,
  description: event.data.description,
  startDate: event.data.date.toISOString().slice(0, 10),
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  organizer: {
    "@type": "Organization",
    name: SITE.name,
    alternateName: SITE.shortName,
    url: Astro.site?.href,
  },
  location: {
    "@type": "Place",
    name: event.data.location ?? SITE.university,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Urbana",
      addressRegion: "IL",
      addressCountry: "US",
    },
  },
}));
---

<ScallopBand>
  <div class="relative flex flex-col gap-5 sm:gap-6">
    <MascotSticker
      src={irisMaimai}
      width={400}
      class="-top-26 left-[58%] hidden w-24 -rotate-3 lg:block 2xl:-top-30 2xl:w-28 3xl:-top-32 3xl:w-30"
      duration="5.6s"
      delay="-1.2s"
    />
    <MascotSticker
      src={irisOngeki}
      width={400}
      class="-top-28 left-[72%] hidden w-24 rotate-3 lg:block 2xl:-top-32 2xl:w-28 3xl:-top-32 3xl:w-30"
      duration="5.6s"
      delay="-2.0s"
    />

    <div class="flex flex-col gap-1.5">
      <h2 class="font-display text-3xl font-bold sm:text-4xl 2xl:text-5xl">
        Upcoming Events
      </h2>
    </div>

    {
      events.length > 0 ? (
        <EventsCarousel events={events} client:visible />
      ) : (
        <p class="font-body text-base sm:text-lg 2xl:text-xl">
          Nothing on the calendar right now, check our Discord for updates.
        </p>
      )
    }
  </div>
</ScallopBand>

{
  eventsSchema.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(eventsSchema)}
    />
  )
}
