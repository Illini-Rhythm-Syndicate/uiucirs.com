---
import ScallopBand from "./ScallopBand.astro";
import TapScene from "./TapScene";

const discordUrl = "https://discord.gg/q9yuXE2PMu";
---

<ScallopBand>
  <div class="flex flex-col gap-1.5">
    <h2 class="font-display text-3xl font-bold sm:text-4xl 2xl:text-5xl">
      Ready to Tap In?
    </h2>
    <p class="font-body text-base sm:text-lg 2xl:text-xl">
      Scan your AIME card to join the discord!
    </p>
  </div>

  <TapScene discordUrl={discordUrl} client:visible />
</ScallopBand>
