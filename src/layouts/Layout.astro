---
import "../styles/global.css";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../utils/paths";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <title>Illini Rhythm Syndicate</title>
  </head>
  <body
    class="flex min-h-dvh flex-col overflow-x-hidden bg-irs-paper text-irs-ink"
  >
    <Header />
    <div
      class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-5 sm:px-8 xl:max-w-6xl 2xl:max-w-7xl 3xl:max-w-360"
    >
      <slot />
    </div>
    <Footer />
  </body>
</html>
